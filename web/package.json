{
  "name": "@career-ops/web",
  "version": "0.9.0",
  "private": true,
  "description": "Official web experience for career-ops — local-first.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:engine": "node --test src/lib/*.test.mjs src/lib/onboarding/*.test.mjs src/lib/search/*.test.mjs src/lib/scoring/*.test.mjs src/lib/apply/*.test.mjs src/lib/beta/*.test.mjs src/lib/home/*.test.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.80",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^5.2.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "pdfjs-dist": "^6.0.227",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
