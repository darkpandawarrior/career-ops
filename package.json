  "keywords": ["ai", "job-search", "claude-code", "opencode", "career", "hiresignal", "career-ops", "careerops", "automation"],
  "author": "Gagandeep Singh",
  "homepage": "https://github.com/kirklazar-android/hiresignal#readme",
  "repository": { "type": "git", "url": "https://github.com/kirklazar-android/hiresignal.git" },
